---
import { getCollection } from "astro:content";

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;

const entries = (await getCollection("standards")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<aside class="sidebar" id="sidebar">
	<nav aria-label="Report navigation">
		<a
			class={currentPath === "/" ? "link overview active" : "link overview"}
			href="/"
			aria-current={currentPath === "/" ? "page" : undefined}
		>
			Report Overview
		</a>

		<div class="group">
			<p class="group-label">Standards</p>
			<ul>
				{
					entries.map((entry) => {
						const href = `/standards/${entry.id}`;
						const active = currentPath === href;
						return (
							<li>
								<a href={href} aria-current={active ? "page" : undefined} class={active ? "link active" : "link"}>
									<span class="numeral link-number">{entry.data.number}</span>
									<span class="link-title">{entry.data.title}</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</nav>
</aside>

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<style>
	.sidebar {
		position: sticky;
		top: var(--header-height);
		width: var(--sidebar-width);
		flex: none;
		height: calc(100vh - var(--header-height));
		overflow-y: auto;
		padding: var(--space-5) var(--space-4);
		background: var(--color-surface);
		border-right: 1px solid var(--color-line);
		scrollbar-width: thin;
		scrollbar-color: var(--color-line) transparent;
		-webkit-tap-highlight-color: transparent;
	}

	.sidebar::-webkit-scrollbar {
		width: 8px;
	}

	.sidebar::-webkit-scrollbar-thumb {
		background: var(--color-line);
		border-radius: 999px;
	}

	.sidebar::-webkit-scrollbar-thumb:hover {
		background: var(--color-ink-muted);
	}

	.overview {
		position: relative;
		font-weight: 600;
		margin-bottom: var(--space-5);
	}

	.group {
		margin-bottom: var(--space-6);
	}

	.group-label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
		margin: 0 var(--space-3) var(--space-2);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.link {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		padding-left: calc(var(--space-3) + 3px);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		color: var(--color-ink);
		text-decoration: none;
		font-size: 0.92rem;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease;
	}

	.link::before {
		content: "";
		position: absolute;
		left: 0;
		top: 18%;
		bottom: 18%;
		width: 3px;
		border-radius: 2px;
		background: var(--color-blue-700);
		opacity: 0;
		transform: scaleY(0.4);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.link:hover {
		background: var(--color-paper);
		color: var(--color-ink);
		transform: translateX(2px);
	}

	.link:hover::before {
		opacity: 0.35;
		transform: scaleY(1);
	}

	.link:active {
		background: var(--color-blue-100);
		transform: translateX(2px) scale(0.98);
		transition-duration: 0.05s;
	}

	.link.active {
		background: var(--color-blue-100);
		color: var(--color-blue-700);
		font-weight: 600;
	}

	.link.active::before {
		opacity: 1;
		transform: scaleY(1);
	}

	.link-number {
		flex: none;
		transition: transform 0.15s ease;
	}

	.link:hover .link-number {
		transform: scale(1.06);
	}

	.link-title {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sidebar-backdrop {
		display: none;
	}

	@media (max-width: 900px) {
		.sidebar {
			position: fixed;
			top: var(--header-height);
			left: 0;
			bottom: 0;
			z-index: 40;
			height: auto;
			transform: translateX(-100%);
			transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
			box-shadow: var(--shadow-md);
		}

		:global(body.nav-open) .sidebar {
			transform: translateX(0);
		}

		.sidebar-backdrop {
			display: block;
			position: fixed;
			inset: var(--header-height) 0 0 0;
			z-index: 35;
			background: rgba(15, 42, 82, 0.4);
			opacity: 0;
			pointer-events: none;
			transition:
				opacity 0.2s ease,
				backdrop-filter 0.2s ease;
		}

		:global(body.nav-open) .sidebar-backdrop {
			opacity: 1;
			pointer-events: auto;
			backdrop-filter: blur(1px);
		}

		.link:hover {
			transform: none;
		}
	}
</style>
