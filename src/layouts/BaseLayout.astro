---
import SiteHeader from "../components/SiteHeader.astro";
import Sidebar from "../components/Sidebar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Volunteer State Community College's SACSCOC Fifth-Year Interim Report." } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} · VSCC 2025 Fifth Year Response</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<div class="shell">
			<Sidebar currentPath={currentPath} />
			<main class="content" id="main-content" tabindex="-1">
				<slot />
			</main>
		</div>
		<SiteFooter />

		<script>
			const toggle = document.getElementById("nav-toggle-button");
			const backdrop = document.getElementById("sidebar-backdrop");
			const sidebar = document.getElementById("sidebar");

			function setNavOpen(isOpen: boolean) {
				document.body.classList.toggle("nav-open", isOpen);
				toggle?.setAttribute("aria-expanded", String(isOpen));
				// Sidebar is translated off-screen on mobile when closed, but stays
				// in the DOM — inert keeps its links out of the tab order so
				// keyboard focus can't land on invisible content.
				if (window.matchMedia("(max-width: 900px)").matches) {
					sidebar?.toggleAttribute("inert", !isOpen);
				}
			}

			function closeNav() {
				setNavOpen(false);
			}

			toggle?.addEventListener("click", () => {
				setNavOpen(!document.body.classList.contains("nav-open"));
			});

			backdrop?.addEventListener("click", closeNav);

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && document.body.classList.contains("nav-open")) {
					closeNav();
					toggle?.focus();
				}
			});
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -100%;
		left: var(--space-4);
		z-index: 50;
		padding: var(--space-2) var(--space-4);
		background: var(--color-blue-900);
		color: white;
		border-radius: 0 0 var(--radius-sm) var(--radius-sm);
		text-decoration: none;
		font-weight: 600;
		transition: top 0.15s ease;
	}

	.skip-link:focus {
		top: 0;
	}

	.shell {
		display: flex;
		align-items: flex-start;
	}

	.content {
		flex: 1;
		min-width: 0;
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-7) var(--space-6);
	}

	.content:focus-visible {
		outline: none;
	}

	@media (max-width: 900px) {
		.content {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
