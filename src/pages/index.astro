---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import campusPhoto from "../assets/vscc.jpg";

const entries = (await getCollection("standards")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Report Overview">
	<section class="hero">
		<Image src={campusPhoto} alt="Aerial view of the Volunteer State Community College campus" />
		<div class="hero-overlay">
			<p class="badge">SACSCOC Fifth-Year Interim Report Response</p>
			<h1>Volunteer State Community College</h1>
			<p class="hero-lede">Prepared in response to the Commission's continued review of accreditation.</p>
		</div>
	</section>

	<section class="callout info-block">
		<dl>
			<div>
				<dt>Institution</dt>
				<dd>Volunteer State Community College</dd>
			</div>
			<div>
				<dt>Address</dt>
				<dd>1480 Nashville Pike, Gallatin, TN 37066</dd>
			</div>
			<div>
				<dt>Submission Date</dt>
				<dd>[Insert submission date]</dd>
			</div>
		</dl>
	</section>

	<section class="callout navigating">
		<h2>Navigating This Report</h2>
		<p>This site organizes the College's response by SACSCOC standard. There are three ways to move through it:</p>
		<ol>
			<li>Use the <strong>sidebar</strong> to jump directly to any standard, grouped by category.</li>
			<li>Use the <strong>previous / next</strong> links at the bottom of each standard's narrative to read in order.</li>
			<li>Use the <strong>standards index</strong> below for an overview of everything addressed in this report.</li>
		</ol>
	</section>

	<section class="standards-index">
		<h2>Standards Addressed</h2>
		<ul class="cards">
			{
				entries.map((entry) => (
					<li>
						<a class="card" href={`/standards/${entry.id}`}>
							<span class="card-number">{entry.data.number}</span>
							<span class="card-title">{entry.data.title}</span>
							<span class="card-summary">{entry.data.statement}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		margin: calc(var(--space-7) * -1) calc(var(--space-6) * -1) var(--space-7);
		border-radius: var(--radius-lg);
		overflow: hidden;
		min-height: 320px;
	}

	.hero :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 420px;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: var(--space-2);
		padding: var(--space-7) var(--space-6);
		background: linear-gradient(0deg, rgba(16, 25, 63, 0.92) 0%, rgba(16, 25, 63, 0.35) 60%, rgba(16, 25, 63, 0.05) 100%);
		color: white;
	}

	.hero-overlay h1 {
		color: white;
		margin: 0;
	}

	.hero-lede {
		max-width: 48ch;
		color: color-mix(in srgb, white 88%, transparent);
		margin: 0;
	}

	.badge {
		width: fit-content;
		color: white;
		background: color-mix(in srgb, var(--color-crimson-600) 70%, transparent);
	}

	.info-block {
		margin-bottom: var(--space-6);
	}

	.info-block dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-5);
		margin: 0;
	}

	.info-block dt {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
		margin-bottom: var(--space-1);
	}

	.info-block dd {
		margin: 0;
		font-weight: 600;
		color: var(--color-navy-900);
	}

	.navigating {
		margin-bottom: var(--space-7);
	}

	.navigating ol {
		margin: 0;
		padding-left: 1.25em;
	}

	.navigating li + li {
		margin-top: var(--space-2);
	}

	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-4);
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		height: 100%;
		padding: var(--space-4);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-md);
		background: var(--color-surface-raised);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
	}

	.card:hover {
		border-color: var(--color-crimson-600);
		box-shadow: var(--shadow-md);
	}

	.card-number {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-crimson-600);
	}

	.card-title {
		font-weight: 600;
		color: var(--color-navy-900);
	}

	.card-summary {
		font-size: 0.85rem;
		color: var(--color-ink-muted);
	}

	@media (max-width: 900px) {
		.hero {
			margin: calc(var(--space-6) * -1) calc(var(--space-4) * -1) var(--space-6);
			border-radius: 0;
		}
	}
</style>
